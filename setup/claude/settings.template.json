  },
  "model": "haiku",
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File <RUTA_HOME>/.claude/statusline.ps1"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "engram@engram": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark"
